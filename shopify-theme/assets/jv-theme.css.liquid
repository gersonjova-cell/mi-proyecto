@font-face{font-family:'JV Display';src:url({{ 'jv-bigshoulders.woff2' | asset_url }}) format('woff2');font-weight:100 900;font-style:normal;font-display:swap;}
@font-face{font-family:'JV Sans';src:url({{ 'jv-archivo.woff2' | asset_url }}) format('woff2');font-weight:100 900;font-style:normal;font-display:swap;}
@font-face{font-family:'JV Mono';src:url({{ 'jv-plexmono-400.woff2' | asset_url }}) format('woff2');font-weight:400;font-style:normal;font-display:swap;}
@font-face{font-family:'JV Mono';src:url({{ 'jv-plexmono-500.woff2' | asset_url }}) format('woff2');font-weight:500;font-style:normal;font-display:swap;}

:root{
  --ink:#050505;
  --ink-2:#0d0d0d;
  --carbon:#171717;
  --line:#292929;
  --bone:#f5f3ee;
  --smoke:#a7a7a7;
  --gold:#b89a58;
  --gold-dim:rgba(184,154,88,.32);
  --font-display:'JV Display','Arial Narrow',sans-serif;
  --font-body:'JV Sans',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;
  --font-mono:'JV Mono','SFMono-Regular',Consolas,monospace;
  --wrap:1280px;
  --pad:20px;
  --local-bg:var(--ink);
  --local-fg:var(--bone);
  --local-muted:var(--smoke);
  --local-line:var(--line);
}
@media(min-width:900px){:root{--pad:64px;}}

.jv *,.jv *::before,.jv *::after{box-sizing:border-box;}
.jv{background:var(--ink);color:var(--bone);font-family:var(--font-body);line-height:1.55;font-size:16px;-webkit-font-smoothing:antialiased;}
.jv h1,.jv h2,.jv h3,.jv p,.jv ul{margin:0;}
.jv ul{padding:0;list-style:none;}
.jv img{max-width:100%;display:block;}
.jv button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;}
.jv a{color:inherit;text-decoration:none;}

.jv .wrap{max-width:var(--wrap);margin:0 auto;padding-left:var(--pad);padding-right:var(--pad);}
.jv .section{position:relative;background:var(--local-bg);color:var(--local-fg);padding:64px 0;}
@media(min-width:700px){.jv .section{padding:96px 0;}}
@media(min-width:1100px){.jv .section{padding:140px 0;}}
.jv .section--tight{padding:48px 0;}
@media(min-width:700px){.jv .section--tight{padding:64px 0;}}
.jv .section--light{--local-bg:var(--bone);--local-fg:var(--ink);--local-muted:#726b58;--local-line:rgba(5,5,5,.16);}

.jv .eyebrow{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);display:inline-block;margin:0 0 18px;}
.jv .h-display{font-family:var(--font-display);font-weight:800;text-transform:uppercase;line-height:.98;letter-spacing:-.01em;text-wrap:balance;color:var(--local-fg);}
.jv .h-display--xl{font-size:clamp(2.6rem,7vw + 1rem,5.4rem);font-weight:900;}
.jv .h-display--lg{font-size:clamp(2.1rem,4.2vw + 1rem,3.6rem);}
.jv .h-display--md{font-size:clamp(1.5rem,2vw + 1rem,2rem);}
.jv .body-text{font-size:clamp(1rem,.3vw + .95rem,1.125rem);color:var(--local-muted);max-width:38em;}
.jv .body-text strong{color:var(--local-fg);font-weight:600;}
.jv .mono{font-family:var(--font-mono);letter-spacing:.02em;}
.jv .mono-num{font-family:var(--font-mono);font-variant-numeric:tabular-nums;}

.jv .btn{display:inline-flex;align-items:center;gap:10px;height:52px;padding:0 30px;font-family:var(--font-body);font-weight:600;font-size:.8rem;letter-spacing:.09em;text-transform:uppercase;white-space:nowrap;transition:background-color .2s ease,color .2s ease,border-color .2s ease;}
.jv .btn--primary{background:var(--local-fg);color:var(--local-bg);border:1px solid var(--local-fg);}
.jv .btn--primary:hover,.jv .btn--primary:focus-visible{background:var(--gold);border-color:var(--gold);color:var(--ink);}
.jv .btn--ghost{background:transparent;color:var(--local-fg);border:1px solid var(--local-line);}
.jv .btn--ghost:hover,.jv .btn--ghost:focus-visible{border-color:var(--gold);color:var(--gold);}
.jv .btn-row{display:flex;flex-direction:column;gap:10px;margin-top:34px;}
.jv .btn-row .btn{width:100%;justify-content:center;}
@media(min-width:560px){.jv .btn-row{flex-direction:row;}.jv .btn-row .btn{width:auto;}}

.jv .link{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-body);font-weight:600;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;color:var(--local-fg);border-bottom:1px solid var(--gold-dim);padding-bottom:3px;transition:color .2s ease,border-color .2s ease;}
.jv .link:hover,.jv .link:focus-visible{color:var(--gold);border-color:var(--gold);}

.jv .seam{height:1px;background-image:repeating-linear-gradient(to right,var(--local-line) 0 7px,transparent 7px 16px);}

.jv .media{position:relative;overflow:hidden;background-color:var(--carbon);}
.jv .section--light .media{background-color:#e7e2d4;}
.jv .media img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;}
.jv .media--ratio-45{aspect-ratio:4/5;}

.jv .reveal{opacity:0;transform:translateY(16px);transition:opacity .5s ease,transform .5s ease;}
.jv .reveal.is-in{opacity:1;transform:translateY(0);}
@media(prefers-reduced-motion:reduce){.jv .reveal{opacity:1;transform:none;transition:none;}}

.jv-announce{background:var(--ink);border-bottom:1px solid var(--line);text-align:center;padding:8px var(--pad);}
.jv-announce span{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--smoke);}
.jv-announce .ann-full{display:none;}
.jv-announce .ann-short{display:inline;}
@media(min-width:600px){.jv-announce .ann-full{display:inline;}.jv-announce .ann-short{display:none;}}

.jv-hero{position:relative;min-height:82svh;display:flex;align-items:flex-end;overflow:hidden;}
@media(min-width:768px){.jv-hero{min-height:calc(100svh - 74px);max-height:840px;align-items:center;}}
.jv-hero .hero-media{position:absolute;inset:0;z-index:0;}
.jv-hero .hero-img{position:absolute;inset:0;}
.jv-hero .hero-img img{width:100%;height:100%;object-fit:cover;}
.jv-hero .hero-img--mobile{display:block;}
.jv-hero .hero-img--desktop{display:none;}
@media(min-width:768px){.jv-hero .hero-img--mobile{display:none;}.jv-hero .hero-img--desktop{display:block;}}
.jv-hero .hero-scrim{position:absolute;inset:0;background:linear-gradient(0deg,rgba(5,5,5,.96) 10%,rgba(5,5,5,.55) 55%,rgba(5,5,5,.15) 100%);}
@media(min-width:768px){.jv-hero .hero-scrim{background:linear-gradient(90deg,rgba(5,5,5,.92) 0%,rgba(5,5,5,.55) 42%,rgba(5,5,5,.08) 68%);}}
.jv-hero .hero-content{position:relative;z-index:1;width:100%;padding:0 20px 44px;}
@media(min-width:768px){.jv-hero .hero-content{padding:0 64px;max-width:640px;}}
.jv-hero .eyebrow{color:var(--gold);}
.jv-hero .hero-sub{margin-top:20px;max-width:320px;font-size:1.05rem;color:rgba(245,243,238,.8);}
@media(min-width:768px){.jv-hero .hero-sub{max-width:440px;font-size:1.15rem;}}
.jv-hero .measure-rail{display:none;}
@media(min-width:768px){.jv-hero .measure-rail{display:block;position:absolute;left:26px;top:0;bottom:0;width:1px;background-image:repeating-linear-gradient(to bottom,rgba(245,243,238,.28) 0 1px,transparent 1px 22px);z-index:1;}}
.jv-hero .hero-tape{position:absolute;left:20px;bottom:16px;z-index:1;display:flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(245,243,238,.5);}
@media(min-width:768px){.jv-hero .hero-tape{left:64px;bottom:28px;}}
.jv-hero .hero-tape::after{content:'';width:1px;height:22px;background:rgba(245,243,238,.35);}

.jv-manifesto{text-align:left;}
.jv-manifesto .wrap{max-width:900px;}
@media(min-width:900px){.jv-manifesto{text-align:center;}}
.jv-manifesto .body-text{margin:0 auto;}
.jv-manifesto .link{margin-top:34px;}

.jv .split-head{display:flex;flex-direction:column;gap:16px;margin-bottom:44px;}
@media(min-width:820px){.jv .split-head{flex-direction:row;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:56px;}.jv .split-head .body-text{max-width:22em;text-align:right;}}

.jv-selection__grid{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 20px 6px;margin:0 -20px;-webkit-overflow-scrolling:touch;}
@media(min-width:1024px){.jv-selection__grid{display:grid;grid-template-columns:repeat(4,1fr);overflow:visible;padding:0;margin:0;gap:22px;}}
.jv .p-card{flex:0 0 74vw;max-width:300px;scroll-snap-align:start;}
@media(min-width:1024px){.jv .p-card{max-width:none;}}
.jv .p-card__img{aspect-ratio:4/5;}
.jv .p-card__img img{transition:opacity .35s ease;}
.jv .p-card__img:hover img.p-card__img-alt{opacity:1;}
.jv .p-card__img img.p-card__img-alt{position:absolute;inset:0;opacity:0;}
.jv .p-card__body{padding-top:16px;}
.jv .p-card__name{font-family:var(--font-body);font-weight:700;font-size:.95rem;text-transform:uppercase;letter-spacing:.01em;}
.jv .p-card__meta{display:block;margin-top:7px;font-family:var(--font-mono);font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--local-muted);}
.jv .p-card__price{display:block;margin-top:9px;font-family:var(--font-mono);font-size:.95rem;font-variant-numeric:tabular-nums;}
.jv .p-card__price s{color:var(--local-muted);margin-right:8px;font-weight:400;}
.jv .p-card__swatches{display:flex;gap:6px;margin-top:12px;}
.jv .p-card__swatches span{width:13px;height:13px;border-radius:50%;border:1px solid rgba(245,243,238,.35);background:rgba(245,243,238,.12);display:block;}
.jv .section--light .p-card__swatches span{border-color:rgba(5,5,5,.3);background:rgba(5,5,5,.08);}
.jv-selection__foot{margin-top:36px;text-align:center;}
@media(min-width:1024px){.jv-selection__foot{display:none;}}

.jv-collections__grid{display:grid;grid-template-columns:1fr;grid-template-areas:"a" "b" "c";gap:2px;}
@media(min-width:820px){.jv-collections__grid{grid-template-columns:1fr 1fr;grid-template-areas:"a b" "c c";gap:22px;}}
.jv .c-card{position:relative;min-height:420px;display:flex;align-items:flex-end;overflow:hidden;}
@media(min-width:820px){.jv .c-card{min-height:520px;}}
.jv .c-card--a{grid-area:a;}
.jv .c-card--b{grid-area:b;}
.jv .c-card--c{grid-area:c;min-height:320px;}
@media(min-width:820px){.jv .c-card--c{min-height:400px;}}
.jv .c-card__img{position:absolute;inset:0;}
.jv .c-card__scrim{position:absolute;inset:0;background:linear-gradient(0deg,rgba(5,5,5,.88) 0%,rgba(5,5,5,.15) 62%);}
.jv .c-card__body{position:relative;z-index:1;padding:26px;}
.jv .c-card__body .h-display{font-size:clamp(1.8rem,4vw + 1rem,2.8rem);}
.jv .c-card__body p{margin-top:12px;max-width:26em;color:rgba(245,243,238,.82);}
.jv .c-card__body .link{margin-top:18px;color:var(--bone);}

@media(min-width:820px){.jv-gsm-layout{display:grid;grid-template-columns:5fr 7fr;gap:60px;align-items:start;}}
.jv .gsm-row{padding:20px 0;border-top:1px solid var(--local-line);display:grid;grid-template-columns:auto 1fr;gap:4px 18px;align-items:baseline;}
.jv .gsm-row:last-child{border-bottom:1px solid var(--local-line);}
.jv .gsm-row__num{font-family:var(--font-mono);font-size:1.6rem;font-variant-numeric:tabular-nums;grid-row:1;}
.jv .gsm-row__cat{font-family:var(--font-body);font-weight:700;font-size:.82rem;letter-spacing:.08em;text-transform:uppercase;text-align:right;grid-row:1;}
.jv .gsm-row__desc{grid-column:1/-1;color:var(--local-muted);font-size:.92rem;max-width:36em;margin-top:2px;}
.jv .gsm-row__bar{grid-column:1/-1;height:2px;background:rgba(5,5,5,.12);margin-top:12px;position:relative;}
.jv .section:not(.section--light) .gsm-row__bar{background:rgba(245,243,238,.14);}
.jv .gsm-row__bar i{position:absolute;left:0;top:0;bottom:0;background:var(--local-fg);display:block;}
.jv .gsm-row__bar b{position:absolute;top:50%;width:6px;height:6px;border-radius:50%;background:var(--gold);transform:translate(-50%,-50%);}
.jv .gsm-note{margin-top:26px;font-size:.8rem;color:var(--local-muted);max-width:40em;}

.jv-material-layout{display:grid;grid-template-columns:1fr;gap:0;}
@media(min-width:900px){.jv-material-layout{grid-template-columns:7fr 5fr;align-items:stretch;gap:0;}}
.jv-material-layout .media{min-height:340px;}
@media(min-width:900px){.jv-material-layout .media{min-height:520px;}}
.jv-material__content{padding:36px 20px 0;}
@media(min-width:900px){.jv-material__content{padding:0 0 0 70px;display:flex;flex-direction:column;justify-content:center;}}
.jv .material-tag{display:block;margin:22px 0 18px;font-family:var(--font-mono);font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);}

.jv-pillars__grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--local-line);}
@media(min-width:820px){.jv-pillars__grid{grid-template-columns:repeat(4,1fr);}}
.jv .pilar{background:var(--local-bg);padding:26px 20px;min-height:190px;border-top:1px solid var(--local-line);}
.jv .pilar__tag{font-family:var(--font-mono);font-size:.78rem;color:var(--gold);}
.jv .pilar h3{margin-top:14px;}
.jv .pilar p{margin-top:10px;font-size:.92rem;color:var(--local-muted);}

.jv-fits__rail{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 20px 6px;margin:0 -20px;}
@media(min-width:1024px){.jv-fits__rail{display:grid;grid-template-columns:repeat(5,1fr);overflow:visible;padding:0;margin:0;gap:14px;}}
.jv .fit-card{flex:0 0 66vw;max-width:250px;scroll-snap-align:start;background:var(--carbon);padding:24px 20px;display:flex;flex-direction:column;}
.jv .section--light .fit-card{background:#efeadb;}
@media(min-width:1024px){.jv .fit-card{max-width:none;}}
.jv .fit-silhouette{width:100%;aspect-ratio:4/5;position:relative;margin-bottom:18px;}
.jv .fit-silhouette i{position:absolute;inset:0;background:linear-gradient(180deg,var(--bone),#cfc9bd);}
.jv .section--light .fit-silhouette i{background:linear-gradient(180deg,var(--ink),#3a3a3a);}
.jv .fit-slim i{clip-path:polygon(42% 0,58% 0,66% 7%,82% 18%,70% 24%,62% 100%,38% 100%,30% 24%,18% 18%,34% 7%);}
.jv .fit-regular i{clip-path:polygon(40% 0,60% 0,70% 8%,88% 20%,74% 27%,66% 100%,34% 100%,26% 27%,12% 20%,30% 8%);}
.jv .fit-loose i{clip-path:polygon(38% 0,62% 0,74% 9%,92% 22%,78% 30%,74% 100%,26% 100%,22% 30%,8% 22%,26% 9%);}
.jv .fit-oversize i{clip-path:polygon(36% 0,64% 0,80% 11%,96% 26%,82% 35%,80% 100%,20% 100%,18% 35%,4% 26%,20% 11%);}
.jv .fit-boxy i{clip-path:polygon(36% 0,64% 0,82% 11%,98% 24%,84% 30%,84% 78%,16% 78%,16% 30%,2% 24%,18% 11%);}
.jv .fit-card__name{font-family:var(--font-display);font-weight:800;text-transform:uppercase;font-size:1.2rem;}
.jv .fit-card p{margin-top:8px;font-size:.88rem;color:var(--local-muted);}
.jv-fits__foot{margin-top:34px;text-align:center;}

.jv-detail{position:relative;min-height:640px;display:flex;align-items:center;overflow:hidden;}
@media(min-width:768px){.jv-detail{min-height:720px;}}
.jv-detail .media{position:absolute;inset:0;}
.jv-detail .detail-scrim{position:absolute;inset:0;background:linear-gradient(0deg,rgba(5,5,5,.94) 0%,rgba(5,5,5,.35) 55%,rgba(5,5,5,.1) 100%);}
@media(min-width:768px){.jv-detail .detail-scrim{background:linear-gradient(90deg,rgba(5,5,5,.92) 0%,rgba(5,5,5,.4) 46%,rgba(5,5,5,.06) 70%);}}
.jv-detail .detail-content{position:relative;z-index:1;padding:0 20px;}
@media(min-width:768px){.jv-detail .detail-content{padding:0 64px;max-width:560px;}}
.jv .detail-lines p{font-size:1.05rem;color:rgba(245,243,238,.86);}
.jv .detail-lines{margin-top:22px;display:flex;flex-direction:column;gap:4px;}
.jv-detail .link{margin-top:28px;color:#f5f3ee;}

.jv-local-layout{display:grid;grid-template-columns:1fr;}
@media(min-width:900px){.jv-local-layout{grid-template-columns:6fr 6fr;align-items:stretch;}}
.jv-local-layout .media{min-height:320px;order:-1;}
@media(min-width:900px){.jv-local-layout .media{order:2;min-height:auto;}}
.jv-local__content{padding:36px 20px;}
@media(min-width:900px){.jv-local__content{padding:70px;display:flex;flex-direction:column;justify-content:center;}}
.jv .local-note{margin-top:16px;font-size:.78rem;color:var(--local-muted);}
.jv-local__content .btn{margin-top:28px;}

.jv-trust__grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--local-line);}
@media(min-width:820px){.jv-trust__grid{grid-template-columns:repeat(4,1fr);}}
.jv .trust{background:var(--local-bg);padding:24px 18px;min-height:170px;}
.jv .trust svg{width:22px;height:22px;stroke:var(--gold);fill:none;stroke-width:1.4;}
.jv .trust h3{margin-top:16px;font-family:var(--font-body);font-weight:700;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;}
.jv .trust p{margin-top:8px;font-size:.86rem;color:var(--local-muted);}

.jv-newsletter{text-align:center;border-top:1px solid var(--line);}
.jv-newsletter .wrap{max-width:640px;}
.jv-newsletter form{margin-top:30px;display:flex;flex-direction:column;gap:10px;}
@media(min-width:560px){.jv-newsletter form{flex-direction:row;height:56px;}}
.jv-newsletter input{height:52px;background:transparent;border:1px solid #454545;color:var(--bone);padding:0 18px;font-family:var(--font-body);font-size:.95rem;flex:1;}
@media(min-width:560px){.jv-newsletter input{height:100%;}}
.jv-newsletter input::placeholder{color:#777;text-transform:uppercase;font-size:.75rem;letter-spacing:.08em;}
.jv-newsletter .btn{height:52px;}
@media(min-width:560px){.jv-newsletter .btn{height:100%;}}
.jv-newsletter__msg{margin-top:16px;font-family:var(--font-mono);font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);min-height:1em;}
.jv-newsletter__helper{margin-top:10px;font-size:.72rem;color:var(--local-muted);}

.jv-footer{background:var(--ink);border-top:1px solid var(--line);padding:64px 0 28px;color:var(--bone);}
.jv-footer .footer-top{display:grid;grid-template-columns:1fr;gap:40px;}
@media(min-width:820px){.jv-footer .footer-top{grid-template-columns:1.4fr .8fr .8fr .8fr 1fr;gap:24px;}}
.jv-footer .logo-lockup{font-family:var(--font-display);font-weight:900;text-transform:uppercase;line-height:.86;letter-spacing:-.01em;font-size:1.4rem;}
.jv-footer .logo-lockup em{display:block;font-style:normal;color:var(--gold);}
.jv-footer .footer-brand p{margin-top:18px;font-size:.92rem;color:var(--smoke);max-width:22em;}
.jv-footer .footer-loc{margin-top:40px;font-family:var(--font-mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:#6f6f6f;}
.jv-footer .foot-col-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;padding:15px 0;border-bottom:1px solid var(--line);font-family:var(--font-body);font-weight:700;font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;text-align:left;color:var(--bone);}
.jv-footer .foot-col-toggle svg{width:14px;height:14px;stroke:var(--bone);fill:none;stroke-width:1.6;transition:transform .25s ease;}
.jv-footer .foot-col.is-open .foot-col-toggle svg{transform:rotate(180deg);}
.jv-footer .foot-col-list{max-height:0;overflow:hidden;transition:max-height .3s ease;}
.jv-footer .foot-col.is-open .foot-col-list{max-height:400px;}
.jv-footer .foot-col-list li{padding:10px 0;font-size:.9rem;color:#9b9b9b;}
.jv-footer .foot-col-list a:hover{color:var(--gold);}
.jv-footer .foot-contact-row{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;}
.jv-footer .foot-contact-row .link{font-size:.7rem;padding-bottom:1px;}
@media(min-width:820px){
  .jv-footer .foot-col-toggle{pointer-events:none;border-bottom:0;padding:0 0 18px;}
  .jv-footer .foot-col-toggle svg{display:none;}
  .jv-footer .foot-col-list{max-height:none!important;overflow:visible;}
}
.jv-footer .footer-bottom{margin-top:60px;padding-top:26px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:14px;font-family:var(--font-mono);font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;color:#6f6f6f;}
@media(min-width:700px){.jv-footer .footer-bottom{flex-direction:row;justify-content:space-between;}}

.jv-wa-float{position:fixed;right:16px;bottom:16px;z-index:45;width:52px;height:52px;border-radius:50%;background:#1f7a4d;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(0,0,0,.4);}
.jv-wa-float svg{width:26px;height:26px;fill:#f5f3ee;}
